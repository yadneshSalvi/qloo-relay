# Local development only. Use a dedicated database and strong credentials in deployment.
DATABASE_URL=postgresql://qloo:qloo_local_dev@127.0.0.1:55432/relay
RELAY_TEST_DATABASE_URL=postgresql://qloo:qloo_local_dev@127.0.0.1:55432/relay_test
# Browser origin; required when a reverse proxy normalizes its internal request host.
APP_ORIGIN=http://127.0.0.1:3101
# Database pool per process (1–10). Production web=4, worker=2.
RELAY_DB_POOL_MAX=10
# Enable only when a separately configured live worker processes this database.
RELAY_LIVE_DISCOVERY_ENABLED=false
# Optional. Missing credentials are shown honestly; sample mode is always explicit.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
# Direct OpenAI Responses provider; secrets stay in server/worker environment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Hard application budgets (UTC day); uncertain requests remain counted.
RELAY_QLOO_DAILY_LIMIT=12
RELAY_QLOO_SESSION_DAILY_LIMIT=6
RELAY_MODEL_DAILY_LIMIT=100
RELAY_MODEL_SESSION_DAILY_LIMIT=32
# Optional Cloud Tasks dispatch; omit these for the persistent local worker.
# GOOGLE_CLOUD_PROJECT=your-project
# RELAY_TASKS_LOCATION=us-central1
# RELAY_TASKS_QUEUE=relay-discovery
# RELAY_WORKER_URL=https://your-private-worker.run.app
# RELAY_TASKS_INVOKER_SERVICE_ACCOUNT=invoker@your-project.iam.gserviceaccount.com

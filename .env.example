# Local development only. Use a dedicated database and strong credentials in deployment.
DATABASE_URL=postgresql://qloo:qloo_local_dev@127.0.0.1:55432/relay
# Browser origin; required when a reverse proxy normalizes its internal request host.
APP_ORIGIN=http://127.0.0.1:3101
# Optional. Missing credentials are shown honestly; sample mode is always explicit.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
